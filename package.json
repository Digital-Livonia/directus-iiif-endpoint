{
	"name": "directus-extension-directus-iiif-endpoint",
	"version": "1.0.12",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-custom-endpoint"
	],
	"type": "module",
	"files": [
		"build"
	],
	"directus:extension": {
		"type": "endpoint",
		"path": "build/index.js",
		"source": "src/index.js",
		"host": "^11.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"package": "rm -rf dist && mkdir dist && npm run build && cp -r build dist/build && cp package.json dist/ && cp README.md dist/ || true"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^11.0.10",
		"eslint": "^8.57.1",
		"eslint-config-standard": "^17.1.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-n": "^16.6.2",
		"eslint-plugin-promise": "^6.6.0",
		"eslint-plugin-react": "^7.37.1",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"@directus/extensions-sdk": {
			"vite": "^5.4.21",
			"axios": "^1.19.0"
		}
	}
}
